cat << 'EOF' > .gitignore
# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
env/
venv/

# Testing & coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Generated model artifacts — regenerate via train_and_save_model()
models/*.joblib

# IDEs & system files
.vscode/
.idea/
.DS_Store
EOF